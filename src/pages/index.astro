---
import '../styles/main.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>Hello, World! 🌍</title>
    <meta
      name="description"
      content="A minimal Astro site with Tailwind CSS"
    />
  </head>

  <body class="min-h-screen bg-emerald-950 text-emerald-50 flex flex-col items-center justify-center overflow-hidden antialiased">
    <!-- Background gradient orbs -->
    <div
      class="fixed inset-0 overflow-hidden pointer-events-none"
      aria-hidden="true"
    >
      <div
        class="absolute top-1/4 left-1/4 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl animate-pulse"
      ></div>

      <div
        class="absolute bottom-1/4 right-1/4 w-64 h-64 bg-lime-500/10 rounded-full blur-3xl animate-pulse"
        style="animation-delay: 1.5s;"
      ></div>
    </div>

    <!-- Main Content -->
    <main class="relative z-10 text-center px-6">
      <div class="mb-8">
        <svg
          aria-hidden="true"
          class="w-16 h-16 mx-auto text-emerald-400 mb-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
      </div>

      <h1 class="text-5xl md:text-7xl font-bold mb-4 bg-linear-to-r from-emerald-400 via-green-400 to-lime-400 bg-clip-text text-transparent">
        Hello, World!
      </h1>

      <p class="text-lg md:text-xl text-emerald-300/70 mb-10 max-w-md mx-auto">
        Built with <span class="text-emerald-400">Astro</span> and{' '}
        <span class="text-lime-400">Tailwind</span>. Simple. Fast. Beautiful.
      </p>

      <button
        id="click-button"
        type="button"
        class="btn-gradient btn-glow text-white px-8 py-4 rounded-full font-semibold text-lg tracking-wide transition-all duration-300 shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/50"
      >
        Click Me
      </button>

      <!-- Counter -->
      <div class="mt-12">
        <p class="text-sm text-emerald-400/60">
          Clicks:
          <span
            id="counter"
            class="font-mono text-emerald-300"
            aria-live="polite"
          >
            0
          </span>
        </p>
      </div>
    </main>

    <footer class="absolute bottom-4 text-xs text-emerald-600/60">
      Made with ☕
    </footer>

    <script>
      const button = document.querySelector<HTMLButtonElement>('#click-button');
      const counter = document.querySelector<HTMLSpanElement>('#counter');

      let clicks = 0;

      button?.addEventListener('click', () => {
        clicks++;

        if (counter) {
          counter.textContent = clicks.toString();
        }
      });
    </script>
  </body>
</html>